---
interface Props {
  publishDate: string;
  publishTime?: string;
  reviewDate: string;
  author?: string;
  reviewCriteria: string;
  sources?: { label: string; url: string }[];
  sourceNote?: string;
}

const {
  publishDate,
  publishTime = "오전",
  reviewDate,
  author = "닥터 홈케어",
  reviewCriteria,
  sources = [],
  sourceNote = '',
} = Astro.props;
---
<div class="article-info-card">
  <div class="ai-row">
    <div class="ai-item">
      <span class="ai-label">발행일</span>
      <span class="ai-value">{publishDate} {publishTime}</span>
    </div>
    <div class="ai-item">
      <span class="ai-label">최종 검토일</span>
      <span class="ai-value">{reviewDate}</span>
    </div>
  </div>
  <div class="ai-row">
    <div class="ai-item">
      <span class="ai-label">작성자</span>
      <span class="ai-value ai-author">{author}</span>
    </div>
    <div class="ai-item">
      <span class="ai-label">검토 기준</span>
      <span class="ai-value">{reviewCriteria}</span>
    </div>
  </div>
  {sources.length > 0 && (
    <div class="ai-sources">
      <span class="ai-label">참고 자료 (공식 출처)</span>
      <span class="ai-source-links">
        {sources.map((s) => (
          <a href={s.url} rel="noopener nofollow" target="_blank">{s.label}</a>
        ))}
      </span>
    </div>
  )}
  {sourceNote && <p class="ai-source-note">{sourceNote}</p>}
</div>

<style>
.article-info-card {
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 20px 24px;
  margin: 4px 0 28px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  background: #fafbfc;
}
.ai-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
.ai-item {
  display: flex;
  flex-direction: column;
  gap: 5px;
}
.ai-label {
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--primary);
}
.ai-value {
  font-size: 0.88rem;
  color: var(--text-muted);
  line-height: 1.5;
}
.ai-author {
  color: var(--accent-dark);
  font-weight: 600;
}
.ai-sources {
  display: flex;
  flex-direction: column;
  gap: 6px;
  border-top: 1px dashed var(--border);
  padding-top: 14px;
}
.ai-source-links { display: flex; flex-wrap: wrap; gap: 8px 14px; }
.ai-source-links a { font-size: 0.83rem; color: var(--accent-dark); font-weight: 600; }
.ai-source-links a:hover { text-decoration: underline; }
.ai-source-note {
  margin: 0;
  border-top: 1px dashed var(--border);
  padding-top: 12px;
  font-size: 0.78rem;
  color: var(--text-muted);
  line-height: 1.65;
}
@media (max-width: 480px) {
  .ai-row { grid-template-columns: 1fr; gap: 10px; }
  .article-info-card { padding: 16px 18px; }
}
</style>
