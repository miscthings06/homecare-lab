---
// 뉴스형 사이드바 틀 — 홈/기사 페이지에서 사용 (2·3단계)
// related: 기사 페이지에서 관련 가이드 목록을 넘기면 "관련 가이드" 박스가 표시됨
export interface Props {
  related?: { href: string; cat: string; title: string }[];
}
const { related = [] } = Astro.props;

const popular = [
  { href: '/cheongso/ipju-cheongso-biyong/', title: '입주청소 비용, 평수별 기준' },
  { href: '/jeolryak/aircon-jeongi/', title: '에어컨 전기요금 계산법' },
  { href: '/isa-junbi/homeservice-dday/', title: '이사 홈서비스 D-30 준비표' },
  { href: '/rental/jeongsugi-rental/', title: '정수기 렌탈 5년 총비용 비교' },
  { href: '/cheongso/yoksil-gompalgi/', title: '욕실 곰팡이 제거 방법' },
  { href: '/rental/rental-vs-purchase/', title: '렌탈 vs 구매, 어느 쪽이 유리?' },
  { href: '/jeolryak/nanbangbi-jeollyak/', title: '겨울 난방비 줄이는 보일러 설정' },
];

const cats = [
  { href: '/cheongso/', label: '청소비용' },
  { href: '/rental/', label: '가전렌탈' },
  { href: '/isa-junbi/', label: '이사준비' },
  { href: '/jeolryak/', label: '생활비절감' },
  { href: '/calculator/', label: '비용 계산기' },
];

const recent = [
  { href: '/isa-junbi/pojang-isa/', cat: '이사준비', title: '포장이사 vs 일반이사 비용 차이' },
  { href: '/jeolryak/energy-voucher/', cat: '생활비절감', title: '에너지바우처 신청 방법' },
  { href: '/cheongso/saetak-cheongso/', cat: '청소비용', title: '세탁기 청소 주기와 통세척 비용' },
  { href: '/rental/gonggi-filter-biyong/', cat: '가전렌탈', title: '공기청정기 필터비 포함 비용' },
  { href: '/jeolryak/jeongi-nujin/', cat: '생활비절감', title: '전기요금 누진제 구간 기준' },
  { href: '/isa-junbi/dosigas/', cat: '이사준비', title: '도시가스 이전·명의변경 방법' },
];
---
<aside class="side">
  <section class="side-box">
    <h2 class="side-title">많이 본 가이드</h2>
    <ol class="side-rank">
      {popular.map((p, i) => (
        <li>
          <span class={i < 3 ? 'side-num hot' : 'side-num'}>{i + 1}</span>
          <a href={p.href}>{p.title}</a>
        </li>
      ))}
    </ol>
  </section>

  {related.length > 0 && (
    <section class="side-box">
      <h2 class="side-title">관련 가이드</h2>
      <ul class="side-related">
        {related.map((r) => (
          <li>
            <a href={r.href}><span class="side-cat">{r.cat}</span>{r.title}</a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="side-box">
    <h2 class="side-title">주제별 바로가기</h2>
    <div class="side-cats">
      {cats.map((c) => (
        <a href={c.href} class="side-cat-chip">{c.label}</a>
      ))}
    </div>
  </section>

  <section class="side-box">
    <h2 class="side-title">최근 업데이트</h2>
    <ul class="side-recent">
      {recent.map((r) => (
        <li>
          <a href={r.href}><span class="side-cat">{r.cat}</span>{r.title}</a>
        </li>
      ))}
    </ul>
  </section>

  <section class="side-cta">
    <p class="side-cta-intro">청소·렌탈 견적이 필요하다면</p>
    <a class="side-cta-btn" href="https://ajd.co.kr" rel="nofollow sponsored noopener" data-partner-cta="true">무료 견적 비교 →</a>
    <p class="side-cta-sub"><a href="/affiliate-disclosure/">제휴 고지</a></p>
  </section>
</aside>

<style>
  .side { display: flex; flex-direction: column; gap: 16px; }
  .side-box { border: 1px solid var(--border); border-radius: 10px; padding: 14px 15px; background: #fff; }
  .side-title {
    font-size: 0.95rem; font-weight: 800; color: var(--primary);
    margin: 0 0 12px; padding-bottom: 8px; border-bottom: 2px solid var(--primary);
  }
  .side-rank { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 11px; }
  .side-rank li { display: flex; gap: 9px; align-items: baseline; }
  .side-num { font-size: 0.85rem; font-weight: 800; color: #c4c0b6; min-width: 13px; }
  .side-num.hot { color: var(--accent); }
  .side-rank a { font-size: 0.85rem; line-height: 1.45; color: var(--text); }
  .side-rank a:hover { color: var(--accent-dark); text-decoration: none; }
  .side-related { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .side-related a { font-size: 0.85rem; line-height: 1.45; color: var(--text); display: block; }
  .side-related a:hover { color: var(--accent-dark); text-decoration: none; }
  .side-cat { display: block; font-size: 0.68rem; font-weight: 700; color: var(--accent-dark); margin-bottom: 3px; }
  .side-cats { display: flex; flex-wrap: wrap; gap: 7px; }
  .side-cat-chip {
    font-size: 0.8rem; font-weight: 600; color: var(--primary);
    background: var(--primary-light); border: 1px solid var(--border);
    border-radius: 999px; padding: 5px 12px;
  }
  .side-cat-chip:hover { background: var(--accent); color: #fff; border-color: var(--accent); text-decoration: none; }
  .side-recent { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .side-recent li { border-bottom: 1px dashed var(--border); padding-bottom: 12px; }
  .side-recent li:last-child { border-bottom: none; padding-bottom: 0; }
  .side-recent a { font-size: 0.85rem; line-height: 1.4; color: var(--text); display: block; }
  .side-recent a:hover { color: var(--accent-dark); text-decoration: none; }
  .side-cta { background: var(--primary); border-radius: 10px; padding: 16px 15px; text-align: center; }
  .side-cta-intro { font-size: 0.8rem; color: rgba(255,255,255,0.75); margin: 0 0 10px; }
  .side-cta-btn {
    display: block; font-size: 0.85rem; font-weight: 700; color: var(--primary);
    background: var(--accent); border-radius: 7px; padding: 9px 0;
  }
  .side-cta-btn:hover { background: #fff; text-decoration: none; }
  .side-cta-sub { margin: 9px 0 0; font-size: 0.72rem; }
  .side-cta-sub a { color: rgba(255,255,255,0.5); }
</style>
