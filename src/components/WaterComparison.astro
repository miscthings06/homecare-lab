---
import { products, verifiedAt } from '../data/water-products.mjs';
const won = (value) => value === null ? '견적 확인 필요' : `${value.toLocaleString('ko-KR')}원`;
const brands = [...new Set(products.map(product => product.brand))];
const groups = [
  { title: '렌탈 견적', tag: 'RENTAL', fields: [
    ['rental', '기본 월 렌탈료', '원', '카드 할인 전, 초기 행사 종료 후 월 요금', 29900],
    ['term', '렌탈료 납부 기간', '개월', '의무사용기간이 아닌 전체 납부 기간', 60],
    ['rentalSetup', '등록·설치 등 초기 비용', '원', '면제라면 0원', 0],
    ['rentalAnnual', '별도 연간 관리·필터 비용', '원/년', '렌탈료에 포함되어 있으면 0원', 0],
  ]},
  { title: '구매 견적', tag: 'PURCHASE', fields: [
    ['purchase', '제품 구매 가격', '원', '동일 모델 또는 동등 사양의 실제 견적', 1200000],
    ['purchaseSetup', '설치 등 초기 비용', '원', '제품 가격에 포함되어 있으면 0원', 0],
    ['purchaseAnnual', '이후 연간 관리·필터 비용', '원/년', '초기 관리비 적용 기간이 끝난 뒤의 연간 비용', 120000],
    ['purchaseCareMonths', '구매 초기 관리비 적용 기간', '개월', '무료·할인 관리 기간. 별도 조건이 없으면 0개월', 0],
    ['purchaseCareMonthly', '구매 초기 월 관리비', '원', '첫 적용 기간 동안의 월 비용. 무료라면 0원', 0],
    ['purchaseBenefit', '확정 구매 할인·환급', '원', '제품 가격에 이미 반영한 할인은 중복 입력 금지', 0],
  ]},
];
const extras = [
  ['promo', '초기 행사 월 요금', '원', '할인액이 아니라 실제 청구되는 월 요금', 14950],
  ['promoMonths', '초기 행사 적용 기간', '개월', '행사가 없으면 0개월', 6],
  ['rentalBenefit', '확정 렌탈 현금 혜택', '원', '실제 받을 금액만 입력. 사은품 정가는 제외', 0],
  ['rentalTermDiscount', '면제 회차 미확인 할인 합계', '원', '전체 납부 기간 총액에서만 차감. 0원 초과 시 중간 누적액·카드 시나리오는 제공하지 않음', 0],
  ['endFee', '납부 종료 시 인수·반납 비용', '원', '전체 납부 기간이 끝나는 달에 한 번 반영', 0],
  ['exitFee', '조기 종료 시 총 추가비용', '원', '위약금·회수비·혜택 환수액 합계. 비교 기간이 납부 기간보다 짧을 때 반영', 0],
  ['afterRental', '납부 기간 이후 월 요금', '원', '계속 이용 가능한 조건의 요금. 소유권 이전 후 없으면 0원', 0],
  ['afterAnnual', '납부 기간 이후 연간 관리비', '원/년', '소유권 이전 후 필터·수리·관리 비용 등', 120000],
];
const cards = [
  ['card', '월 카드 할인액', '원', '실적 조건을 충족하는 달의 할인액', 0],
  ['cardMonths', '카드 할인 적용 기간', '개월', '첫 달부터 연속으로 적용되는 것으로 가정', 0],
  ['cardAnnual', '카드 연회비', '원/년', '새 카드 발급 기준으로 매 12개월 시작 시 반영', 0],
];
---
<section id="compare" class="water-tool" aria-labelledby="compare-title">
  <section id="official-products" class="official-products" aria-labelledby="official-title">
    <p class="eyebrow">OFFICIAL PRICE CHECK</p>
    <h2 id="official-title">공식 가격부터, 같은 조건으로</h2>
    <p class="tool-intro">{brands.join('·')} {products.length}개 모델의 공식 가격과 선택 조건을 확인했습니다. 구매가 미확인 모델은 별도로 표시하며, 카드·결합·선납 할인과 사은품은 제외합니다.</p>
    <p class="price-date">공식몰 확인일 <time datetime={verifiedAt}>{verifiedAt}</time> · 실시간 연동 아님 · 주문 전 가격 재확인</p>
    <p id="price-stale" class="warning" hidden>확인 후 30일이 지난 가격입니다. 행사 종료·요금 변경 여부를 공식몰에서 확인하고 입력값을 수정해주세요.</p>
    <div class="brand-filter" role="group" aria-label="브랜드 선택">
      {['전체', ...brands].map(brand => <button type="button" data-brand-filter={brand} aria-pressed={brand === '전체' ? 'true' : 'false'}>{brand}</button>)}
    </div>
    <div class="product-grid">
      {products.map(product => <article class="product-card" data-brand={product.brand}>
        <p class="product-brand">{product.brand}</p><h3>{product.name}</h3>
        <p class="model-code">{product.model}</p><p class="product-option">{product.option}</p>
        <dl><div><dt>제품 구매가 · 관리비 별도</dt><dd class:list={{'unverified-price': product.purchase === null}}>{won(product.purchase)}</dd></div>
          <div><dt>렌탈/구독 · {product.term}개월 납부</dt><dd class="rental-price">{product.promoMonths > 0 ? <>첫 {product.promoMonths}개월 월 {won(product.promo)}<span>이후 월 {won(product.rental)}</span></> : <>월 {won(product.rental)}<span>5개월 면제 · 적용 회차 확인 필요</span></>}</dd></div>
          <div><dt>{product.term}개월 렌탈/구독 요금 합계</dt><dd class="contract-total">{won(product.rentalTotal)}</dd></div>
        </dl>
        <p class="product-care">{product.care}</p>
        <details><summary>가격 조건·출처 확인</summary><p>{product.notes}</p>
          {product.sources.map(source => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.label} ↗</a>)}
        </details>
        <button type="button" class="select-product" data-product={product.id} aria-pressed="false">{product.brand} {product.name} 가격 불러오기</button>
      </article>)}
    </div>
    <p class="privacy-note">각 카드의 계약 기간이 다르므로 합계만으로 브랜드 순위를 매기지 않습니다. 아래에서 동일 모델의 렌탈과 구매를 비교하세요. 공식 출처 링크는 제휴 추적 링크가 아닙니다.</p>
  </section>
  <div class="tool-heading"><div><p class="eyebrow">WATER PURIFIER COST LAB</p><h2 id="compare-title">내 견적으로 총비용 비교</h2></div><span class="tool-label">무료 · 회원가입 없음</span></div>
  <p class="tool-intro">같은 제품, 같은 사용 기간으로 맞춰보세요. 월 요금에 가려진 관리비와 할인 조건까지 나눠 계산합니다.</p>
  <div class="example-notice" id="quote-mode"><strong>현재 금액은 계산 방법을 보여주는 가상 예시입니다.</strong> 실제 판매 가격이나 추천 상품이 아닙니다. 받은 견적으로 바꿔 입력하세요.</div>
  <noscript><p class="example-notice">계산하려면 JavaScript를 활성화해주세요. 아래 계산 기준은 JavaScript 없이도 읽을 수 있습니다.</p></noscript>
  <form id="water-form">
    <div id="product-context" class="product-context" hidden><strong id="selected-product-name"></strong><p id="selected-product-notes"></p><p id="selected-product-sources"></p>
      <label><input id="price-confirmed" type="checkbox" /> 선택 옵션·가격 확인일을 확인했고, 추가 설치비·종료 비용 등 내 견적 조건을 검토했습니다.</label>
    </div>
    <div class="period-row">
      <label for="water-months">얼마나 사용할 계획인가요?</label>
      <div class="period-input"><input id="water-months" name="months" type="number" value="60" min="1" max="120" step="1" required /><span>개월</span></div>
      <div class="period-buttons" aria-label="비교 기간 빠른 선택"><button type="button" data-period="36">3년</button><button type="button" data-period="60">5년</button><button type="button" data-period="84">7년</button></div>
    </div>
    <div class="quote-grid">
      {groups.map(group => <fieldset class="quote-card">
        <legend><span>{group.tag}</span>{group.title}</legend>
        {group.fields.map(([name, label, unit, hint, value]) => <div class="field">
          <label for={`water-${name}`}>{label}</label>
          <div class="input-wrap"><input id={`water-${name}`} name={name} type="number" inputmode="numeric" min={name === 'term' ? 1 : 0} max={name === 'term' ? 120 : 100000000} step="1" value={value} required aria-describedby={`hint-${name}`} /><span>{unit}</span></div>
          <small id={`hint-${name}`}>{hint}</small>
        </div>)}
      </fieldset>)}
    </div>
    <details class="extra-settings" open>
      <summary>초기 할인·계약 종료 조건 <span>내 견적에 맞게 확인</span></summary>
      <div class="extra-grid">{extras.map(([name, label, unit, hint, value]) => <div class="field">
        <label for={`water-${name}`}>{label}</label>
        <div class="input-wrap"><input id={`water-${name}`} name={name} type="number" inputmode="numeric" min="0" max={name === 'promoMonths' ? 120 : 100000000} step="1" value={value} required aria-describedby={`hint-${name}`} /><span>{unit}</span></div>
        <small id={`hint-${name}`}>{hint}</small>
      </div>)}</div>
    </details>
    <details class="extra-settings">
      <summary>제휴카드 할인 시나리오 <span>기본 결과와 별도로 계산</span></summary>
      <p class="details-note">카드 할인 전 총비용이 기본 비교 기준입니다. 실적을 채우기 위한 추가 소비와 다른 카드 혜택의 포기는 계산하지 않습니다.</p>
      <div class="extra-grid">{cards.map(([name, label, unit, hint, value]) => <div class="field">
        <label for={`water-${name}`}>{label}</label>
        <div class="input-wrap"><input id={`water-${name}`} name={name} type="number" inputmode="numeric" min="0" max={name === 'cardMonths' ? 120 : 100000000} step="1" value={value} required aria-describedby={`hint-${name}`} /><span>{unit}</span></div>
        <small id={`hint-${name}`}>{hint}</small>
      </div>)}</div>
    </details>
    <p class="error-message" id="water-error" role="alert"></p>
    <div class="form-actions"><button class="primary-action" type="submit">총비용 비교하기 <span aria-hidden="true">↗</span></button><button type="button" id="blank-quote" class="secondary-action">내 견적 새로 입력</button><button type="button" id="example-quote" class="text-action">가상 예시 불러오기</button></div>
    <p class="privacy-note">입력한 견적은 서버로 전송하거나 저장하지 않습니다. 페이지를 닫으면 사라집니다.</p>
  </form>
  <section id="water-results" class="results" hidden tabindex="-1" aria-labelledby="result-title">
    <div class="result-heading"><p class="eyebrow" id="result-context"></p><h3 id="result-title"></h3><p id="result-subtitle"></p></div>
    <div class="totals"><div><span>렌탈 총비용 · 카드 할인 전</span><strong id="rental-total"></strong><div class="cost-bar"><i id="rental-bar"></i></div><small id="rental-monthly"></small></div><div><span>구매 총비용 · 관리비 포함</span><strong id="purchase-total"></strong><div class="cost-bar purchase-bar"><i id="purchase-bar"></i></div><small id="purchase-monthly"></small></div></div>
    <p id="contract-warning" class="warning"></p>
    <div id="card-result" class="card-result" hidden></div>
    <div class="table-scroll"><table><caption>총비용 구성 · 원 단위</caption><thead><tr><th scope="col">항목</th><th scope="col">렌탈</th><th scope="col">구매</th></tr></thead><tbody id="breakdown"></tbody></table></div>
    <p id="schedule-warning" class="warning" hidden>면제 적용 회차가 확인되지 않아 할인은 만기 총액에만 합산했습니다. 실제 청구 일정으로 오해하지 않도록 기간별 누적액은 표시하지 않습니다.</p>
    <details id="timeline-details" class="timeline-details"><summary>기간별 누적비용 보기</summary><div class="table-scroll"><table><caption>카드 할인 전 누적 지출 · 선택한 종료 시점의 추가비용 포함</caption><thead><tr><th scope="col">경과 기간</th><th scope="col">렌탈</th><th scope="col">구매</th></tr></thead><tbody id="timeline"></tbody></table></div></details>
    <p class="result-caveat">입력 조건에 따른 예상 지출 비교이며, 상품 추천이나 최저가 보장이 아닙니다. 초기 혜택은 시작 시점에 반영하고 관리비는 월할 계산합니다. 실제 청구 시점과 다를 수 있습니다.</p>
    <button type="button" id="copy-result" class="secondary-action">계산 내역 복사</button><span id="copy-status" role="status"></span>
  </section>
  <section class="methodology" id="calculation-method">
    <p class="eyebrow">HOW WE CALCULATE</p><h3>숫자보다 중요한, 계산의 기준</h3>
    <div class="method-grid"><div><h4>01 / 동일 조건으로 비교</h4><p>모델명·냉온수·얼음 기능·방문 관리 여부를 맞추세요. 렌탈료에 필터와 관리가 포함되어 있다면 별도 관리비를 중복 입력하지 않습니다.</p></div><div><h4>02 / 지출을 항목별로 합산</h4><p>렌탈 = 초기 비용 + 기간별 월 요금 + 별도 관리비 + 종료 비용 − 확정 혜택. 구매 = 제품 가격 + 설치비 + 관리비 − 확정 할인입니다.</p></div><div><h4>03 / 계약 이후도 확인</h4><p>의무사용기간과 전체 납부 기간은 다를 수 있습니다. 소유권 이전 시점, 반납·인수 비용, 이후 관리 조건을 견적서에서 확인하세요.</p></div></div>
    <details><summary>계산 가정과 제외 항목 자세히 보기</summary><ul>
      <li>1~120개월을 비교합니다. 모든 입력은 부가세 포함 원화 정수 기준입니다.</li>
      <li>초기 행사 요금은 첫 달부터 입력 개월 수만큼 적용하고 이후 기본 월 요금을 적용합니다.</li>
      <li>면제 적용 회차를 모르는 할인은 만기 총액에만 합산합니다. 이 경우 비교 기간을 전체 납부 기간과 같게 설정해야 하며, 기간별 누적액·제휴카드 결과는 제공하지 않습니다. 실제 면제 시점이 만기라는 뜻은 아닙니다.</li>
      <li>구매 초기 관리비는 지정한 개월 수 동안 월 요금을 적용하고, 이후에는 연간 관리비를 12로 나누어 반영합니다. 무료 관리 기간에는 초기 월 관리비를 0원으로 입력하세요. 실제 필터 교체 청구 시점과는 다를 수 있습니다.</li>
      <li>비교 기간이 전체 납부 기간보다 짧으면 그 시점에 계약을 끝내는 시나리오입니다. 추가비용은 자동 추정하지 않습니다. 업체에서 확인한 위약금·혜택 환수액·회수비를 직접 입력하세요.</li>
      <li>납부 종료 후에는 입력한 이후 월 요금·관리비를 적용합니다. 기기를 반납하는 계약이라면 계속 사용할 수 없으므로 대체 기기 비용을 별도로 검토하세요.</li>
      <li>카드 할인은 첫 달부터 연속 적용하고, 해당 월 렌탈 요금을 넘지 않도록 제한합니다. 연회비는 할인 적용 기간 동안 12개월마다 한 번 반영합니다.</li>
      <li>전기·수도요금, 물가 상승, 이자, 제품 잔존가치, 미입력 수리비·이전 설치비는 제외합니다. 편의성과 A/S 조건은 금액 외에 따로 비교하세요.</li>
      <li>기본 입력값은 가상 예시입니다. 공식 가격 불러오기는 표시된 확인일·모델·옵션의 수동 확인 데이터이며 실시간 가격이 아닙니다. 불러온 값도 수정할 수 있으며 결과는 최종 입력값 기준입니다. 확인되지 않은 구매 관리비는 직접 입력해야 합니다.</li>
    </ul></details>
    <p class="method-version">계산 기준 v1.2 · 2026.10.21 · <a href="/contact/">오류·개선 의견 보내기</a></p>
  </section>
</section>
<script>
  import { compare, example } from '../lib/water-cost.mjs';
  import { products, productQuote, verifiedAt } from '../data/water-products.mjs';
  const form = document.querySelector<HTMLFormElement>('#water-form')!;
  const results = document.querySelector<HTMLElement>('#water-results')!;
  const error = document.querySelector<HTMLElement>('#water-error')!;
  const notice = document.querySelector<HTMLElement>('#quote-mode')!;
  const money = (n: number) => `${n.toLocaleString('ko-KR')}원`;
  let isExample = true, summary = '';
  let selected: typeof products[number] | undefined;
  const el = (id: string) => document.getElementById(id)!;
  const input = (key: string) => form.elements.namedItem(key) as HTMLInputElement;
  const confirmation = document.querySelector<HTMLInputElement>('#price-confirmed')!;
  document.querySelectorAll<HTMLButtonElement>('[data-brand-filter]').forEach(button => {
    button.addEventListener('click', () => {
      document.querySelectorAll<HTMLButtonElement>('[data-brand-filter]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      document.querySelectorAll<HTMLElement>('[data-brand]').forEach(card => { card.hidden = button.dataset.brandFilter !== '전체' && card.dataset.brand !== button.dataset.brandFilter; });
    });
  });
  if (Date.now() - Date.parse(`${verifiedAt}T00:00:00+09:00`) > 30 * 86400000) el('price-stale').hidden = false;
  function clearProduct() {
    selected = undefined; el('product-context').hidden = true; confirmation.required = false; confirmation.checked = false;
    document.querySelectorAll('[data-product]').forEach(button => button.setAttribute('aria-pressed', 'false'));
  }
  document.querySelectorAll<HTMLButtonElement>('[data-product]').forEach(button => {
    button.addEventListener('click', () => {
      selected = products.find(product => product.id === button.dataset.product)!;
      for (const [key, value] of Object.entries(productQuote(selected))) input(key).value = value === null ? '' : String(value);
      results.hidden = true; error.textContent = ''; isExample = false;
      confirmation.checked = false; confirmation.required = true; el('product-context').hidden = false;
      el('selected-product-name').textContent = `${selected.brand} ${selected.name} · ${selected.model} · 확인일 ${verifiedAt}`;
      el('selected-product-notes').textContent = `${selected.option}. ${selected.notes}`;
      el('selected-product-sources').replaceChildren();
      for (const source of selected.sources) {
        const link = document.createElement('a'); link.href = source.url; link.textContent = `${source.label} ↗ `;
        link.target = '_blank'; link.rel = 'noopener noreferrer'; el('selected-product-sources').append(link);
      }
      document.querySelectorAll<HTMLButtonElement>('[data-product]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      notice.textContent = `공식 확인 가격 불러옴 · ${selected.brand} ${selected.name}. ${selected.purchase === null ? '구매가는 미확인이므로 견적을 받아 입력해주세요. ' : ''}${selected.purchaseAnnual === null ? '구매 후 관리비는 확인되지 않아 비워두었습니다. 무료 관리 기간도 견적서와 확인해주세요.' : '구매 케어십의 기간별 요금도 반영했습니다.'} 추가 비용 0원은 기본 설치·정상 만기 시나리오이므로 견적서와 대조해주세요.${selected.rentalTermDiscount ? ' 면제 회차 미확인 할인은 만기 총액에만 반영합니다.' : ''}`;
      el('product-context').scrollIntoView({ block: 'start', behavior: 'instant' });
    });
  });
  function invalidate() {
    results.hidden = true; error.textContent = ''; isExample = false;
    notice.textContent = selected ? `공식 가격 기반 편집 · ${selected.brand} ${selected.name}. 결과는 수정된 입력값 기준이며 공식 견적이 아닙니다.` : '직접 입력 모드 · 수정하지 않은 예시 금액도 남아 있을 수 있습니다. 모든 항목을 견적서와 대조해주세요.';
  }
  function periodChanged() {
    if (!selected) return;
    input('exitFee').value = Number(input('months').value) < Number(input('term').value) ? '' : '0';
    input('afterAnnual').value = Number(input('months').value) > Number(input('term').value) ? '' : '0';
    confirmation.checked = false;
  }
  form.addEventListener('input', invalidate);
  input('months').addEventListener('input', periodChanged);
  input('term').addEventListener('input', periodChanged);
  document.querySelectorAll<HTMLButtonElement>('[data-period]').forEach(button => {
    button.addEventListener('click', () => { input('months').value = button.dataset.period!; invalidate(); periodChanged(); });
  });
  el('blank-quote').addEventListener('click', () => {
    clearProduct();
    invalidate();
    for (const key of Object.keys(example)) input(key).value = key === 'months' || key === 'term' ? '60' : '0';
    input('rental').value = ''; input('purchase').value = ''; input('purchaseAnnual').value = '';
    notice.textContent = '새 견적 입력 · 렌탈료, 구매 가격, 관리비를 입력하고 나머지 조건도 확인해주세요. 초기 할인은 적용되지 않은 상태입니다.';
    input('rental').focus();
  });
  el('example-quote').addEventListener('click', () => {
    clearProduct();
    for (const [key, value] of Object.entries(example)) input(key).value = String(value);
    results.hidden = true; error.textContent = ''; isExample = true;
    notice.textContent = '가상 예시 · 실제 판매 가격이나 추천 상품이 아닙니다. 계산 방법을 확인한 뒤 받은 견적으로 바꿔주세요.';
  });
  function addRow(body: HTMLElement, values: string[]) {
    const row = document.createElement('tr');
    values.forEach((value, index) => {
      const cell = document.createElement(index === 0 ? 'th' : 'td');
      if (index === 0) cell.setAttribute('scope', 'row');
      cell.textContent = value; row.append(cell);
    });
    body.append(row);
  }
  form.addEventListener('submit', event => {
    event.preventDefault();
    const values = Object.fromEntries(Object.keys(example).map(key => [key, input(key).value === '' ? NaN : Number(input(key).value)]));
    try {
      if (selected && values.months > 84) throw new Error('공식 확인 관리비는 최대 84개월까지입니다. 그 이후는 업체에 확인한 후 ‘내 견적 새로 입력’으로 비교해주세요.');
      const r = compare(values), diff = r.rent - r.buy;
      const headline = diff === 0 ? '입력 조건에서는 총비용이 같습니다' : `${diff > 0 ? '구매가' : '렌탈이'} ${money(Math.abs(diff))} 적게 듭니다`;
      el('result-context').textContent = `${selected ? `${selected.brand} ${selected.model} · 최종 입력값 기준` : isExample ? '가상 예시 결과' : '입력 견적 기준'} · ${values.months}개월 비교 · 카드 할인 전`;
      el('result-title').textContent = headline;
      el('result-subtitle').textContent = '금액 차이와 함께 관리 서비스, 소유권, A/S 조건을 확인하세요.';
      el('rental-total').textContent = money(r.rent); el('purchase-total').textContent = money(r.buy);
      el('rental-monthly').textContent = `월평균 ${money(Math.round(r.rent / values.months))}`;
      el('purchase-monthly').textContent = `월평균 ${money(Math.round(r.buy / values.months))}`;
      const max = Math.max(r.rent, r.buy, 1);
      el('rental-bar').style.width = `${r.rent / max * 100}%`; el('purchase-bar').style.width = `${r.buy / max * 100}%`;
      el('contract-warning').textContent = values.months < values.term
        ? `주의: 납부 기간 ${values.term}개월 전에 종료하는 비교입니다. 입력한 조기 종료 비용 ${money(values.exitFee)}만 반영했습니다. 업체 확인 전에는 최종 판단에 사용하지 마세요.`
        : values.months > values.term
          ? `납부 종료 후 ${values.months - values.term}개월은 입력한 이후 요금·관리비로 계산했습니다. 기기를 계속 보유·이용할 수 있는 계약인지 확인하세요.`
          : '전체 납부 기간까지 비교했습니다. 소유권 이전·반납 조건과 입력한 종료 비용을 확인하세요.';
      const card = el('card-result'); card.hidden = !(values.card > 0 && values.cardMonths > 0);
      card.textContent = `카드 조건 충족 시 렌탈 총비용 ${money(r.cardRent)} (할인 −${money(r.cardDiscount)}, 연회비 +${money(r.cardFee)}). 구매 대비 ${money(Math.abs(r.cardRent - r.buy))} ${r.cardRent > r.buy ? '많음' : r.cardRent < r.buy ? '적음' : '차이 없음'}. 추가 소비 비용은 제외한 조건부 결과입니다.`;
      const rows = [
        ['제품·월 요금 합계', money(r.rentPayments), money(values.purchase)],
        ['초기 등록·설치', money(values.rentalSetup), money(values.purchaseSetup)],
        ['관리·필터 비용', money(r.rentCare), money(r.buyCare)],
        ['인수·반납·조기 종료', money(r.transfer + r.exit), '미반영'],
        ['확정 혜택·할인', `−${money(values.rentalBenefit + r.termDiscount)}`, `−${money(values.purchaseBenefit)}`],
        ['총비용 (카드 할인 전)', money(r.rent), money(r.buy)],
      ];
      el('breakdown').replaceChildren(); rows.forEach(row => addRow(el('breakdown'), row));
      el('timeline').replaceChildren();
      el('timeline-details').hidden = values.rentalTermDiscount > 0;
      el('schedule-warning').hidden = !(values.rentalTermDiscount > 0);
      r.series.filter((p: { month: number }) => p.month % 12 === 0 || p.month === values.months)
        .forEach((p: { month: number; rent: number; buy: number }) => addRow(el('timeline'), [`${p.month}개월`, money(p.rent), money(p.buy)]));
      summary = [`홈케어랩 정수기 총비용 비교 · ${isExample ? '가상 예시' : '사용자 입력'}`, `${values.months}개월 · ${headline}`,
        ...(selected ? [`가격 시작점: ${selected.brand} ${selected.model} (${verifiedAt} 확인). 수정 입력 가능.`, selected.notes, ...selected.sources.map(source => source.url)] : []),
        ...(values.rentalTermDiscount > 0 ? ['면제 회차 미확인: 할인은 만기 총액에만 합산. 중간 누적액·카드 시나리오 제외.'] : []),
        ...rows.map(row => `${row[0]}: 렌탈 ${row[1]} / 구매 ${row[2]}`), ...(card.hidden ? [] : [card.textContent!]), el('contract-warning').textContent,
        '입력값 (금액: 원, 기간: 개월, 연간 비용: 원/년):',
        ...Object.keys(example).map(key => `${key === 'months' ? '비교 기간' : form.querySelector(`label[for="water-${key}"]`)?.textContent}: ${values[key]}`),
        '관리비는 월할 계산. 미입력 비용·잔존가치·이자 제외.', 'https://www.homecare-lab.co.kr/calculator/water-purifier/'].join('\n');
      error.textContent = ''; el('copy-status').textContent = ''; results.hidden = false;
      results.focus({ preventScroll: true }); results.scrollIntoView({ block: 'start', behavior: 'instant' });
    } catch (e) {
      results.hidden = true; error.textContent = e instanceof Error ? e.message : '입력 조건을 확인해주세요.';
    }
  });
  el('copy-result').addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(summary); el('copy-status').textContent = ' 계산 내역을 복사했습니다.'; }
    catch { el('copy-status').textContent = ' 복사 권한이 없습니다. 화면의 결과를 직접 선택해 복사해주세요.'; }
  });
</script>
