---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  cover?: string;
  preloadImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = '청소부터 가전렌탈까지, 우리집 생활비 줄이는 홈서비스 가이드. 입주청소·이사청소·가전렌탈·생활비절감 정보를 정리합니다.',
  ogImage = '/og-default.png',
  canonical,
  cover,
  preloadImage,
  noindex = false,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
// 실사(jpg/png/webp) 표지가 있으면 OG 공유 이미지로도 사용
const _isRasterCover = !!cover && /\.(jpe?g|png|webp)$/i.test(cover);
const _ogSrc = _isRasterCover ? cover : ogImage;
// og:image는 반드시 절대 URL이어야 소셜/구글에서 인식됨
const ogImageURL = _ogSrc.startsWith('http') ? _ogSrc : new URL(_ogSrc, Astro.site).href;
const pageTitle = title.includes('홈케어랩') ? title : `${title} | 홈케어랩`;

// 상단 유틸바 날짜 (빌드 시점 — 클라이언트 JS가 방문자 오늘 날짜로 갱신)
const _wd = ['일', '월', '화', '수', '목', '금', '토'];
const _now = new Date();
const buildDate = `${_now.getFullYear()}. ${_now.getMonth() + 1}. ${_now.getDate()}. (${_wd[_now.getDay()]})`;

// 기사 페이지 판별 — 카테고리 하위 글에만 뉴스형 2열(본문+사이드바) 적용
const _segs = Astro.url.pathname.split('/').filter(Boolean);
const _cats = ['cheongso', 'rental', 'isa-junbi', 'jeolryak'];
const isArticle = _cats.includes(_segs[0]) && _segs.length >= 2;
const _catLabels = { cheongso: '청소비용', rental: '가전렌탈', 'isa-junbi': '이사준비', jeolryak: '생활비절감' };
const catLabel = _catLabels[_segs[0]] || '';

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://www.homecare-lab.co.kr/#website',
  url: 'https://www.homecare-lab.co.kr/',
  name: '홈케어랩',
  description: '청소·가전렌탈·이사준비·생활비 절감 비용을 비교하는 홈서비스 정보 사이트',
  inLanguage: 'ko-KR',
};
const breadcrumbLd = isArticle ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: 'https://www.homecare-lab.co.kr/' },
    { '@type': 'ListItem', position: 2, name: catLabel, item: `https://www.homecare-lab.co.kr/${_segs[0]}/` },
    { '@type': 'ListItem', position: 3, name: title, item: canonicalURL },
  ],
} : null;
const structuredData = breadcrumbLd ? [websiteLd, breadcrumbLd] : [websiteLd];

// 승인 코드와 자동 광고가 비콘텐츠·색인 제외 화면에 붙지 않도록 제한
const _nonMonetizedPaths = new Set([
  '/404.html',
  '/about/',
  '/affiliate-disclosure/',
  '/contact/',
  '/disclaimer/',
  '/privacy/',
  '/sitemap/',
  '/terms/',
]);
// 승인 거절 상태에서는 빈 광고 스크립트가 성능만 소모하지 않도록 기본 비활성화한다.
// 재심사 또는 승인 후 빌드 환경에 PUBLIC_ADSENSE_ENABLED=true를 지정하면 다시 로드된다.
const adsenseEnabled = import.meta.env.PUBLIC_ADSENSE_ENABLED === 'true';
const shouldLoadAdSense = adsenseEnabled && !noindex && !_nonMonetizedPaths.has(Astro.url.pathname);
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
  <meta name="google-site-verification" content="tIiMK28Yg0Un0owVfo9fp1vNqaQ2sI_ENMYmdR2Xot8" />
  <meta name="naver-site-verification" content="a4b0627aceb0db403506dfc1296e39b327975953" />
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- OG / SNS -->
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${ogImageURL}?v=8`} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:image" content={`${ogImageURL}?v=8`} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content={isArticle ? 'article' : 'website'} />
  <meta property="og:locale" content="ko_KR" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />

  <!-- 구글 폰트 -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
  {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

  <!-- CSS는 Astro 빌드 시 자동 처리됩니다 -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />

  <!-- Google AdSense: 콘텐츠가 있는 색인 대상 화면에만 로드 -->
  {shouldLoadAdSense && (
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6351448423579853"
      crossorigin="anonymous"></script>
  )}

  <!-- Google Analytics 4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-CCT0XXDJE0"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-CCT0XXDJE0');
  </script>
</head>
<body>
  <!-- 상단 유틸바 -->
  <div class="util-bar">
    <div class="container util-inner">
      <span class="util-date" id="utilDate">{buildDate}</span>
      <nav class="util-links" aria-label="유틸리티 메뉴">
        <a href="/about/">소개</a>
        <a href="/contact/">문의</a>
        <a href="/affiliate-disclosure/">제휴 고지</a>
      </nav>
    </div>
  </div>

  <!-- 헤더(마스트헤드) -->
  <header>
    <div class="container header-inner">
      <a href="/" class="logo"><span class="logo-name">홈케어<em>랩</em></span><span class="logo-tagline">생활·홈서비스 전문 정보</span></a>
      <a href="/calculator/" class="masthead-link">비용 계산기 →</a>
    </div>
  </header>

  <!-- 카테고리 탭 내비 -->
  <nav class="cat-nav" aria-label="카테고리 메뉴">
    <div class="container cat-nav-inner">
      <a href="/cheongso/" class={Astro.url.pathname.startsWith('/cheongso') ? 'active' : ''}>청소비용</a>
      <a href="/rental/" class={Astro.url.pathname.startsWith('/rental') ? 'active' : ''}>가전렌탈</a>
      <a href="/isa-junbi/" class={Astro.url.pathname.startsWith('/isa-junbi') ? 'active' : ''}>이사준비</a>
      <a href="/jeolryak/" class={Astro.url.pathname.startsWith('/jeolryak') ? 'active' : ''}>생활비절감</a>
      <a href="/calculator/" class={Astro.url.pathname.startsWith('/calculator') ? 'active' : ''}>계산기</a>
    </div>
  </nav>

  <!-- 본문 -->
  <main>
    <div class:list={isArticle ? ['article-layout', 'container'] : ['l-pass']}>
      <div class:list={isArticle ? ['article-col', _isRasterCover && 'has-cover'] : ['l-pass']}>
        {isArticle && cover && (_isRasterCover ? (
          <div class="article-hero">
            <img class="article-cover" src={cover} alt={title} width="1200" height="630" loading="eager" />
            <div class="article-hero-overlay">
              {catLabel && <span class="article-hero-cat">{catLabel}</span>}
              <p class="article-hero-title">{title}</p>
            </div>
          </div>
        ) : (
          <img class="article-cover" src={cover} alt={title} width="1200" height="630" loading="eager" />
        ))}
        <slot />
      </div>
      {isArticle && <Sidebar />}
    </div>
  </main>

  <!-- 푸터 (사이트맵형) -->
  <footer>
    <div class="container footer-top">
      <div class="footer-brand">
        <div class="footer-logo">홈케어랩</div>
        <p class="footer-tag">청소부터 가전렌탈까지, 우리집 생활비 줄이는 홈서비스 가이드</p>
        <div class="footer-policy">
          <a href="/about/">소개</a>
          <a href="/contact/">문의</a>
          <a href="/privacy/">개인정보처리방침</a>
          <a href="/terms/">이용약관</a>
          <a href="/affiliate-disclosure/">광고·제휴 고지</a>
          <a href="/disclaimer/">면책조항</a>
          <a href="/sitemap/">사이트맵</a>
        </div>
      </div>
      <nav class="footer-cols">
        <div class="footer-col">
          <h3><a href="/cheongso/">청소비용</a></h3>
          <a href="/cheongso/ipju-cheongso-biyong/">입주청소 비용</a>
          <a href="/cheongso/aircon-cheongso/">에어컨 청소</a>
          <a href="/cheongso/yoksil-gompalgi/">욕실 곰팡이 제거</a>
          <a href="/cheongso/saetak-cheongso/">세탁기 청소</a>
          <a href="/cheongso/hood-biyong/">주방 후드 청소</a>
        </div>
        <div class="footer-col">
          <h3><a href="/rental/">가전렌탈</a></h3>
          <a href="/rental/rental-vs-purchase/">렌탈 vs 구매</a>
          <a href="/rental/jeongsugi-rental/">정수기 렌탈</a>
          <a href="/rental/gonggi-rental/">공기청정기 렌탈</a>
          <a href="/rental/geondogi-rental/">건조기 렌탈</a>
          <a href="/rental/rental-haejibiyong/">렌탈 해지비용</a>
        </div>
        <div class="footer-col">
          <h3><a href="/isa-junbi/">이사준비</a></h3>
          <a href="/isa-junbi/homeservice-dday/">이사 홈서비스 준비표</a>
          <a href="/isa-junbi/pojang-isa/">포장이사 vs 일반이사</a>
          <a href="/isa-junbi/dosigas/">도시가스 이전</a>
          <a href="/isa-junbi/internet-sinyu-vs-isa/">인터넷 이전 vs 신규</a>
          <a href="/isa-junbi/isa-checklist/">이사 체크리스트</a>
        </div>
        <div class="footer-col">
          <h3><a href="/jeolryak/">생활비절감</a></h3>
          <a href="/jeolryak/jeongi-nujin/">전기요금 누진제</a>
          <a href="/jeolryak/aircon-jeongi/">에어컨 전기요금</a>
          <a href="/jeolryak/nanbangbi-jeollyak/">겨울 난방비 절감</a>
          <a href="/jeolryak/energy-voucher/">에너지바우처</a>
          <a href="/calculator/">비용 계산기</a>
        </div>
      </nav>
    </div>
    <div class="container footer-bottom">
      <p class="footer-disclaimer">홈케어랩은 아정당 파트너스 활동을 통해 일정 수수료를 받을 수 있습니다. 제휴 여부와 관계없이 콘텐츠는 홈서비스 비용 기준과 선택 조건을 설명하기 위해 작성됩니다. 본 사이트는 홈케어 서비스 직접 제공자가 아니며, 상담·계약은 아정당 및 각 업체를 통해 진행됩니다.</p>
      <p class="footer-copy">© 2026 홈케어랩. 본 사이트의 정보는 참고용이며, 실제 비용은 업체마다 다를 수 있습니다.</p>
    </div>
  </footer>

  <script>
    // 상단 유틸바 날짜 (방문자 기준 오늘)
    (function () {
      var el = document.getElementById('utilDate');
      if (!el) return;
      var wd = ['일', '월', '화', '수', '목', '금', '토'];
      var d = new Date();
      el.textContent = d.getFullYear() + '. ' + (d.getMonth() + 1) + '. ' + d.getDate() + '. (' + wd[d.getDay()] + ')';
    })();

    // FAQ 아코디언
    document.querySelectorAll('.faq-q').forEach(q => {
      q.addEventListener('click', () => {
        q.closest('.faq-item')?.classList.toggle('open');
      });
    });

    // NEW 배지 24시간 자동 숨김
    document.querySelectorAll('.new-badge[data-pub]').forEach(function(el) {
      if (Date.now() - new Date(el.dataset.pub).getTime() > 864e5) {
        el.style.display = 'none';
      }
    });
  </script>
</body>
</html>
