---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  cover?: string;
}

const {
  title,
  description = '청소부터 가전렌탈까지, 우리집 생활비 줄이는 홈서비스 가이드. 입주청소·이사청소·가전렌탈·생활비절감 정보를 정리합니다.',
  ogImage = '/og-default.png',
  canonical,
  cover,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
// 실사(jpg/png/webp) 표지가 있으면 OG 공유 이미지로도 사용
const _isRasterCover = !!cover && /\.(jpe?g|png|webp)$/i.test(cover);
const _ogSrc = _isRasterCover ? cover : ogImage;
// og:image는 반드시 절대 URL이어야 소셜/구글에서 인식됨
const ogImageURL = _ogSrc.startsWith('http') ? _ogSrc : new URL(_ogSrc, Astro.site).href;
const pageTitle = title.includes('홈케어랩') ? title : `${title} | 홈케어랩`;

// 상단 유틸바 날짜 (빌드 시점 — 클라이언트 JS가 방문자 오늘 날짜로 갱신)
const _wd = ['일', '월', '화', '수', '목', '금', '토'];
const _now = new Date();
const buildDate = `${_now.getFullYear()}. ${_now.getMonth() + 1}. ${_now.getDate()}. (${_wd[_now.getDay()]})`;

// 기사 페이지 판별 — 카테고리 하위 글에만 뉴스형 2열(본문+사이드바) 적용
const _segs = Astro.url.pathname.split('/').filter(Boolean);
const _cats = ['cheongso', 'rental', 'isa-junbi', 'jeolryak'];
const isArticle = _cats.includes(_segs[0]) && _segs.length >= 2;
const _catLabels = { cheongso: '청소비용', rental: '가전렌탈', 'isa-junbi': '이사준비', jeolryak: '생활비절감' };
const catLabel = _catLabels[_segs[0]] || '';
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="google-site-verification" content="tIiMK28Yg0Un0owVfo9fp1vNqaQ2sI_ENMYmdR2Xot8" />

  <!-- OG / SNS -->
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${ogImageURL}?v=8`} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:image" content={`${ogImageURL}?v=8`} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ko_KR" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />

  <!-- 구글 폰트 -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;600;700;800;900&display=swap" rel="stylesheet" />

  <!-- CSS는 Astro 빌드 시 자동 처리됩니다 -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />

  <!-- Google AdSense -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6351448423579853"
     crossorigin="anonymous"></script>

  <!-- Google Analytics 4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-CCT0XXDJE0"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-CCT0XXDJE0');
  </script>
</head>
<body>
  <!-- 상단 유틸바 -->
  <div class="util-bar">
    <div class="container util-inner">
      <span class="util-date" id="utilDate">{buildDate}</span>
      <nav class="util-links" aria-label="유틸리티 메뉴">
        <a href="/about/">소개</a>
        <a href="/contact/">문의</a>
        <a href="/affiliate-disclosure/">제휴 고지</a>
      </nav>
    </div>
  </div>

  <!-- 헤더(마스트헤드) -->
  <header>
    <div class="container header-inner">
      <a href="/" class="logo"><span class="logo-name">홈케어<em>랩</em></span><span class="logo-tagline">생활·홈서비스 전문 정보</span></a>
      <a href="/calculator/" class="masthead-link">비용 계산기 →</a>
    </div>
  </header>

  <!-- 카테고리 탭 내비 -->
  <nav class="cat-nav" aria-label="카테고리 메뉴">
    <div class="container cat-nav-inner">
      <a href="/cheongso/" class={Astro.url.pathname.startsWith('/cheongso') ? 'active' : ''}>청소비용</a>
      <a href="/rental/" class={Astro.url.pathname.startsWith('/rental') ? 'active' : ''}>가전렌탈</a>
      <a href="/isa-junbi/" class={Astro.url.pathname.startsWith('/isa-junbi') ? 'active' : ''}>이사준비</a>
      <a href="/jeolryak/" class={Astro.url.pathname.startsWith('/jeolryak') ? 'active' : ''}>생활비절감</a>
      <a href="/calculator/" class={Astro.url.pathname.startsWith('/calculator') ? 'active' : ''}>계산기</a>
    </div>
  </nav>

  <!-- 본문 -->
  <main>
    <div class:list={isArticle ? ['article-layout', 'container'] : ['l-pass']}>
      <div class:list={isArticle ? ['article-col', _isRasterCover && 'has-cover'] : ['l-pass']}>
        {isArticle && cover && (_isRasterCover ? (
          <div class="article-hero">
            <img class="article-cover" src={cover} alt={title} width="1200" height="630" loading="eager" />
            <div class="article-hero-overlay">
              {catLabel && <span class="article-hero-cat">{catLabel}</span>}
              <p class="article-hero-title">{title}</p>
            </div>
          </div>
        ) : (
          <img class="article-cover" src={cover} alt={title} width="1200" height="630" loading="eager" />
        ))}
        <slot />
      </div>
      {isArticle && <Sidebar />}
    </div>
  </main>

  <!-- 푸터 -->
  <footer>
    <div class="container footer-inner">
      <div class="footer-logo">홈케어랩</div>
      <p>청소부터 가전렌탈까지, 우리집 생활비 줄이는 홈서비스 가이드</p>
      <div class="footer-links">
        <a href="/about/">소개</a>
        <a href="/contact/">문의</a>
        <a href="/privacy/">개인정보처리방침</a>
        <a href="/terms/">이용약관</a>
        <a href="/affiliate-disclosure/">광고·제휴 고지</a>
        <a href="/disclaimer/">면책조항</a>
        <a href="/sitemap/">사이트맵</a>
      </div>
      <p style="font-size:0.8rem;color:rgba(255,255,255,0.45);line-height:1.7;max-width:680px">
        홈케어랩은 아정당 파트너스 활동을 통해 일정 수수료를 받을 수 있습니다. 제휴 여부와 관계없이 콘텐츠는 홈서비스 비용 기준과 선택 조건을 설명하기 위해 작성됩니다. 본 사이트는 홈케어 서비스 직접 제공자가 아니며, 상담·계약은 아정당 및 각 업체를 통해 진행됩니다.
      </p>
      <p class="footer-copy">© 2026 홈케어랩. 본 사이트의 정보는 참고용이며, 실제 비용은 업체마다 다를 수 있습니다.</p>
    </div>
  </footer>

  <script>
    // 상단 유틸바 날짜 (방문자 기준 오늘)
    (function () {
      var el = document.getElementById('utilDate');
      if (!el) return;
      var wd = ['일', '월', '화', '수', '목', '금', '토'];
      var d = new Date();
      el.textContent = d.getFullYear() + '. ' + (d.getMonth() + 1) + '. ' + d.getDate() + '. (' + wd[d.getDay()] + ')';
    })();

    // FAQ 아코디언
    document.querySelectorAll('.faq-q').forEach(q => {
      q.addEventListener('click', () => {
        q.closest('.faq-item')?.classList.toggle('open');
      });
    });

    // NEW 배지 24시간 자동 숨김
    document.querySelectorAll('.new-badge[data-pub]').forEach(function(el) {
      if (Date.now() - new Date(el.dataset.pub).getTime() > 864e5) {
        el.style.display = 'none';
      }
    });
  </script>
</body>
</html>
