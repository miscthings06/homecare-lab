  (document.getElementById('rental-result') as HTMLElement).style.display = 'none';
  document.getElementById('rental-calc-btn')?.scrollIntoView({ behavior:'smooth', block:'center' });
});

// ③ 전기요금 — 가전 프리셋
const elecTips: Record<string, string> = {
  '냉방': '💡 에어컨은 설정 온도 1도 높일수록 약 7% 전력 절감됩니다. 선풍기 병행 시 체감 온도 2~3도 낮아집니다.',
  '난방': '💡 전기히터는 가동 시간 단축이 핵심입니다. 적정 온도 도달 후 끄고 보온재·내복으로 체감 온도를 높이세요.',
  '건조': '💡 건조기 필터를 매 사용 후 청소하면 전력 효율이 유지됩니다. 저온 건조 모드 활용 시 15~25% 절감 가능합니다.',
  '냉장': '💡 냉장고는 24시간 가동되므로 직사광선을 피하고 벽과 10cm 이상 간격을 유지하면 소비전력이 낮아집니다.',
  '조리': '💡 전기밥솥 보온 기능은 전력 소모가 큽니다. 조리 후 바로 끄고 단열 용기에 보관하는 방법을 고려하세요.',
  '영상': '💡 TV 미시청 시 대기전력(0.5~3W)이 계속 소모됩니다. 콘센트를 뽑거나 스마트 멀티탭을 활용하세요.',
  '공조': '💡 공기청정기는 저전력 기기지만 24시간 가동 시 연간 2~4만원 수준입니다. 자동 모드로 두면 효율적입니다.',
  '세탁': '💡 세탁기는 냉수 세탁 전환만으로 온수 가열 비용을 없앨 수 있습니다. 가득 채워 1회 세탁이 소량 여러 번보다 효율적입니다.',
};

document.querySelectorAll('.elec-preset').forEach(btn => {
  btn.addEventListener('click', () => {
    const el = btn as HTMLElement;
    document.querySelectorAll('.elec-preset').forEach(b => b.classList.remove('selected'));
    el.classList.add('selected');
    const watt = el.dataset.watt!;
    const hours = el.dataset.hours!;
    const days = el.dataset.days!;
    const tip = el.dataset.tip!;
    // watt select 매칭
    const wattSel = document.getElementById('elec-watt') as HTMLSelectElement;
    const opts = Array.from(wattSel.options).map(o => o.value);
    if (opts.includes(watt)) wattSel.value = watt;
    (document.getElementById('elec-watt-custom') as HTMLInputElement).value = '';
    (document.getElementById('elec-hours') as HTMLInputElement).value = hours;
    (document.getElementById('elec-days') as HTMLInputElement).value = days;
    const tipBox = document.getElementById('elec-tip-box') as HTMLElement;
    const tipText = document.getElementById('elec-tip-text') as HTMLElement;
    if (elecTips[tip]) {
      tipText.textContent = elecTips[tip];
      tipBox.style.display = 'block';
    } else {
      tipBox.style.display = 'none';
    }
  });
});

// 전기요금 계산기
document.getElementById('jeongi-calc-btn')?.addEventListener('click', () => {
  const customWatt = parseInt((document.getElementById('elec-watt-custom') as HTMLInputElement).value);
  const selectedWatt = parseInt((document.getElementById('elec-watt') as HTMLSelectElement).value);
  const watt = customWatt > 0 ? customWatt : selectedWatt;
  const hours = parseFloat((document.getElementById('elec-hours') as HTMLInputElement).value);
  const days = parseInt((document.getElementById('elec-days') as HTMLInputElement).value);
  const price = parseInt((document.getElementById('elec-price') as HTMLSelectElement).value);
  if (!watt || !hours || !days) { alert('소비전력, 사용 시간, 사용 일수를 입력해주세요.'); return; }
  const kwhPerMonth = watt / 1000 * hours * days;
  const cost = Math.round(kwhPerMonth * price);
  const annualCost = cost * 12;
  (document.getElementById('jeongi-range') as HTMLElement).innerHTML =
    `월 추가 전기요금 약 <strong>${cost.toLocaleString('ko-KR')}원</strong>`;
  const yearlyStr = annualCost >= 10000 ? `연간 약 ${Math.round(annualCost/10000)}만원` : `연간 약 ${annualCost.toLocaleString('ko-KR')}원`;
  (document.getElementById('jeongi-detail') as HTMLElement).innerHTML =
    `월 소비 전력량 ${kwhPerMonth.toFixed(1)} kWh &nbsp;·&nbsp; ${yearlyStr}`;
  const noteEl = document.getElementById('jeongi-note') as HTMLElement;
  noteEl.textContent = customWatt > 0
    ? `직접 입력한 ${customWatt}W 기준으로 계산되었습니다. 실제 요금은 가구 전체 사용량·누진 구간에 따라 달라집니다.`
    : `실제 전기요금은 가구별 전체 사용량·누진 구간에 따라 달라집니다. 이 값은 해당 가전제품 단독 추가분입니다.`;
  const res = document.getElementById('jeongi-result') as HTMLElement;
  res.style.display = 'block';
  res.scrollIntoView({ behavior:'smooth', block:'nearest' });
});

