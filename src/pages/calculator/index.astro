// ② 렌탈 — 천단위 콤마 자동 포맷
function setupCommaInput(id: string) {
  const el = document.getElementById(id) as HTMLInputElement;
  if (!el) return;
  el.addEventListener('input', () => {
    const pos = el.selectionStart ?? 0;
    const raw = el.value.replace(/[^0-9]/g, '');
    const formatted = raw ? parseInt(raw).toLocaleString('ko-KR') : '';
    el.value = formatted;
    // 커서 위치 보정
    const diff = formatted.length - el.value.length;
    try { el.setSelectionRange(pos + diff, pos + diff); } catch(e) {}
  });
}
setupCommaInput('rental-fee');
setupCommaInput('buy-price');
setupCommaInput('annual-maintenance');

function parseComma(id: string): number {
  const el = document.getElementById(id) as HTMLInputElement;
  return parseInt((el?.value ?? '0').replace(/,/g, '')) || 0;
}

// 렌탈 프리셋
document.querySelectorAll('.preset-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const el = btn as HTMLElement;
    // 같은 패널의 preset만 selected 처리
    const panel = el.closest('.calc-panel');
    panel?.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('selected'));
    el.classList.add('selected');
    if (el.dataset.fee !== undefined) {
      // 렌탈 프리셋
      const fee = parseInt(el.dataset.fee!);
      const buy = parseInt(el.dataset.buy!);
      const maint = parseInt(el.dataset.maint!);
      (document.getElementById('rental-fee') as HTMLInputElement).value = fee.toLocaleString('ko-KR');
      (document.getElementById('rental-months') as HTMLSelectElement).value = el.dataset.months!;
      (document.getElementById('buy-price') as HTMLInputElement).value = buy.toLocaleString('ko-KR');
      (document.getElementById('annual-maintenance') as HTMLInputElement).value = maint > 0 ? maint.toLocaleString('ko-KR') : '0';
    }
  });
});

// 렌탈 계산기
document.getElementById('rental-calc-btn')?.addEventListener('click', () => {
  const fee = parseComma('rental-fee');
  const months = parseInt((document.getElementById('rental-months') as HTMLSelectElement).value);
  const buyPrice = parseComma('buy-price');
  const annualMaint = parseComma('annual-maintenance');
  const channelBenefit = parseInt((document.querySelector('input[name="rental-channel"]:checked') as HTMLInputElement)?.value ?? '0');
  const ownership = parseInt((document.querySelector('input[name="rental-ownership"]:checked') as HTMLInputElement)?.value ?? '0');
  if (!fee || !buyPrice) { alert('렌탈료와 구매 가격을 입력해주세요.'); return; }
  const ownershipCost = ownership === 2 ? 75000 : 0;
  const totalRental = fee * months - channelBenefit + ownershipCost;
  const totalBuy = buyPrice + (annualMaint * months / 12);
  const totalBuyRound = Math.round(totalBuy);
  const fmt = (n: number) => Math.round(Math.abs(n) / 10000) + '만원';
  let breakEven = 0;
  for (let m=1; m<=200; m++) {
    const rCost = fee * m - channelBenefit + ownershipCost;
    const bCost = buyPrice + annualMaint * m / 12;
    if (bCost < rCost) { breakEven = m; break; }
  }
  const diff = totalRental - totalBuyRound;
  const isRentalCheaper = diff <= 0;
  const isClose = !isRentalCheaper && Math.abs(diff) < 300000;
  const fmtW = (n: number) => n.toLocaleString('ko-KR');
  const years = (months / 12).toFixed(0);

  // 결론 텍스트 — 렌탈 유리성 중심
  let conclusionHead = '';
  let conclusionBody = '';
  if (isRentalCheaper) {
    conclusionHead = `✅ ${months}개월 기준, 렌탈이 ${fmt(Math.abs(diff))} 더 유리합니다`;
    conclusionBody = `렌탈료에는 필터 교체·방문 점검·고장 수리 등 유지관리 서비스가 이미 포함된 금액입니다. 구매 후에는 이 비용을 별도로 부담해야 하므로, 실질 차이는 계산값보다 더 클 수 있습니다.`;
  } else if (isClose) {
    conclusionHead = `💡 비용 차이 ${fmt(Math.abs(diff))} — 관리 서비스 가치까지 고려하면 렌탈이 합리적`;
    conclusionBody = `단순 금액 차이가 크지 않습니다. 구매 시 필터 교체·수리·점검을 직접 부담해야 하는 점을 감안하면, 유지관리가 포함된 렌탈이 실질적으로 더 유리한 선택입니다.`;
  } else {
    conclusionHead = `구매가 ${fmt(Math.abs(diff))} 저렴하지만 — 렌탈의 관리 서비스 가치를 확인하세요`;
    conclusionBody = `렌탈에는 정기 필터 교체·고장 수리·방문 점검이 포함됩니다. 비교채널 경유 가입 시 평균 20만원 혜택으로 실질 비용 차이를 좁힐 수 있습니다. 자가 관리가 번거롭거나 이사 계획이 있다면 렌탈이 더 합리적입니다.`;
  }
  if (breakEven > 0 && breakEven <= months) {
    conclusionBody += ` <strong>${breakEven}개월</strong> 이전까지는 렌탈 누적비용이 구매보다 낮습니다.`;
  }

  // 가로형 VS 인포그래픽
  const infographic = document.getElementById('rental-infographic') as HTMLElement;
  infographic.innerHTML = `
    <div class="rc-period">📊 ${months}개월(${years}년) 약정 기준 총비용 비교</div>
    <div class="rc-compare">
      <div class="rc-col ${isRentalCheaper || isClose ? 'rc-col--win' : ''}">
        <div class="rc-col-head">
          <span class="rc-col-emoji">📋</span>
          <span class="rc-col-title">렌탈</span>
          ${isRentalCheaper || isClose ? '<span class="rc-recommend-badge">추천</span>' : ''}
        </div>
        <div class="rc-col-amount">${fmt(totalRental)}</div>
        <ul class="rc-col-items">
          <li>월 ${fmtW(fee)}원 × ${months}개월</li>
          ${channelBenefit > 0 ? `<li class="rc-plus">혜택 ${fmt(channelBenefit)} 차감 반영</li>` : ''}
          <li class="rc-plus">✓ 필터·소모품 관리 포함</li>
          <li class="rc-plus">✓ 고장·수리 서비스 포함</li>
          <li class="rc-plus">✓ 초기비용 없음</li>
        </ul>
      </div>
      <div class="rc-vs">
        <div class="rc-vs-text">VS</div>
        ${Math.abs(diff) > 0
          ? `<div class="rc-vs-pill ${isRentalCheaper ? '' : 'rc-vs-pill--buy'}">${isRentalCheaper ? '렌탈' : '구매'}<br>${fmt(Math.abs(diff))}<br>저렴</div>`
          : '<div style="font-size:0.7rem;color:var(--text-muted);margin-top:4px;text-align:center;">동일</div>'}
      </div>
      <div class="rc-col ${!isRentalCheaper && !isClose ? 'rc-col--win-buy' : ''}">
        <div class="rc-col-head">
          <span class="rc-col-emoji">💳</span>
          <span class="rc-col-title">구매</span>
        </div>
        <div class="rc-col-amount">${fmt(totalBuyRound)}</div>
        <ul class="rc-col-items">
          <li>초기비용 ${fmt(buyPrice)}</li>
          ${annualMaint > 0
            ? `<li>유지비 연 ${fmt(annualMaint)} × ${years}년</li>`
            : '<li class="rc-minus">유지비 미입력 · 실제 더 높음</li>'}
          <li class="rc-minus">▲ 필터·관리 직접 부담</li>
          <li class="rc-minus">▲ 고장 수리비 별도</li>
        </ul>
      </div>
    </div>
    <div class="rc-conclusion">
      <strong>${conclusionHead}</strong>
      <p>${conclusionBody}</p>
    </div>`;

  // CTA
  const ctaWrap = document.getElementById('rental-cta-wrap') as HTMLElement;
  ctaWrap.innerHTML = `
    <a href="https://partners.ajl.to/lead/rental?partnerId=UDXBJ0IC" rel="nofollow sponsored noopener" data-partner-cta="true" class="rc-cta-btn">
      무료 견적받기 →
    </a>
    <p class="rc-cta-note">* 제휴 링크 · 이용자 추가 비용 없음 · <a href="/affiliate-disclosure/" style="color:inherit;text-decoration:underline">제휴 고지</a></p>`;

  const res = document.getElementById('rental-result') as HTMLElement;
  res.style.display = 'block';
  res.scrollIntoView({ behavior:'smooth', block:'nearest' });
});

// 렌탈 초기화
document.getElementById('rental-reset-btn')?.addEventListener('click', () => {
  (document.getElementById('rental-fee') as HTMLInputElement).value = '';
  (document.getElementById('rental-months') as HTMLSelectElement).value = '60';
  (document.getElementById('buy-price') as HTMLInputElement).value = '';
  (document.getElementById('annual-maintenance') as HTMLInputElement).value = '0';
  (document.querySelector('input[name="rental-channel"][value="0"]') as HTMLInputElement).checked = true;
