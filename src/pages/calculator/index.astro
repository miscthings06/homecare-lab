<script>
// 탭 전환
document.querySelectorAll('.calc-tab').forEach(tab => {
  tab.addEventListener('click', () => {
    const target = (tab as HTMLElement).dataset.tab;
    document.querySelectorAll('.calc-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.calc-panel').forEach(p => p.classList.remove('active'));
    tab.classList.add('active');
    document.getElementById(target!)?.classList.add('active');
  });
});
const hash = location.hash.replace('#','');
if (hash) { const tab = document.querySelector(`[data-tab="${hash}"]`) as HTMLElement; if (tab) tab.click(); }

// ① 입주청소 계산기
document.getElementById('ipju-calc-btn')?.addEventListener('click', () => {
  const sizeEl = document.getElementById('ipju-size') as HTMLSelectElement;
  const size = parseInt(sizeEl.value);
  if (!size) { alert('평수를 선택해주세요.'); return; }
  const type = (document.getElementById('ipju-type') as HTMLSelectElement).value;
  const status = parseFloat((document.getElementById('ipju-status') as HTMLSelectElement).value);
  const years = parseFloat((document.getElementById('ipju-years') as HTMLSelectElement).value);
  const dirty = parseFloat((document.querySelector('input[name="ipju-dirty"]:checked') as HTMLInputElement)?.value ?? '1');
  const smoke = parseFloat((document.querySelector('input[name="ipju-smoke"]:checked') as HTMLInputElement)?.value ?? '1');
  const base: Record<number,[number,number]> = {
    10:[100000,180000], 15:[130000,200000], 20:[160000,250000], 25:[220000,330000],
    30:[280000,400000], 33:[320000,450000], 40:[400000,600000], 50:[600000,900000]
  };
  const typeBonus: Record<string,number> = { apt:1, villa:0.92, officetel:0.88 };
  let [low, high] = base[size];
  const mult = dirty * smoke * status * years * typeBonus[type];
  low = Math.round(low * mult / 10000) * 10000;
  high = Math.round(high * mult / 10000) * 10000;
  let addTotal = 0;
  ['add-changtul','add-aircon','add-aircon2','add-hood','add-mold','add-saetak','add-mattress'].forEach(id => {
    const el = document.getElementById(id) as HTMLInputElement;
    if (el?.checked) addTotal += parseInt(el.value);
  });
  if ((document.getElementById('add-veranda1') as HTMLInputElement)?.checked) addTotal += 25000;
  if ((document.getElementById('add-veranda2') as HTMLInputElement)?.checked) addTotal += 50000;
  low += addTotal; high += addTotal;
  const fmt = (n: number) => Math.round(n/10000) + '만원';
  (document.getElementById('ipju-range') as HTMLElement).innerHTML = `예상 비용 <strong>${fmt(low)} ~ ${fmt(high)}</strong>`;
  const details: string[] = [];
  if (dirty > 1) details.push(`오염도 가산 ×${dirty}`);
  if (smoke > 1) details.push(`흡연 가산 ×${smoke}`);
  if (addTotal > 0) details.push(`추가 항목 +${fmt(addTotal)}`);
  (document.getElementById('ipju-detail') as HTMLElement).innerHTML = details.length ? details.join(' · ') : '기본 기준 적용';
  const res = document.getElementById('ipju-result') as HTMLElement;
  res.style.display = 'block';
  res.scrollIntoView({ behavior:'smooth', block:'nearest' });
});

// 입주청소 초기화
document.getElementById('ipju-reset-btn')?.addEventListener('click', () => {
  (document.getElementById('ipju-size') as HTMLSelectElement).value = '';
  (document.getElementById('ipju-type') as HTMLSelectElement).value = 'apt';
  (document.getElementById('ipju-status') as HTMLSelectElement).value = '1.1';
  (document.getElementById('ipju-years') as HTMLSelectElement).value = '1';
  (document.querySelector('input[name="ipju-dirty"][value="1"]') as HTMLInputElement).checked = true;
  (document.querySelector('input[name="ipju-smoke"][value="1"]') as HTMLInputElement).checked = true;
  ['add-changtul','add-veranda1','add-veranda2','add-aircon','add-aircon2','add-hood','add-mold','add-saetak','add-mattress'].forEach(id => {
    (document.getElementById(id) as HTMLInputElement).checked = false;
  });
  (document.getElementById('ipju-result') as HTMLElement).style.display = 'none';
});

// 입주청소 다시 계산
document.getElementById('ipju-retry-btn')?.addEventListener('click', () => {
  (document.getElementById('ipju-result') as HTMLElement).style.display = 'none';
  document.getElementById('ipju-calc-btn')?.scrollIntoView({ behavior:'smooth', block:'center' });
});

// ② 렌탈 프리셋
document.querySelectorAll('.preset-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const el = btn as HTMLElement;
    document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('selected'));
    el.classList.add('selected');
    (document.getElementById('rental-fee') as HTMLInputElement).value = el.dataset.fee!;
    (document.getElementById('rental-months') as HTMLSelectElement).value = el.dataset.months!;
    (document.getElementById('buy-price') as HTMLInputElement).value = el.dataset.buy!;
    (document.getElementById('annual-maintenance') as HTMLInputElement).value = el.dataset.maint!;
  });
});

// 렌탈 계산기
document.getElementById('rental-calc-btn')?.addEventListener('click', () => {
  const fee = parseInt((document.getElementById('rental-fee') as HTMLInputElement).value);
  const months = parseInt((document.getElementById('rental-months') as HTMLSelectElement).value);
  const buyPrice = parseInt((document.getElementById('buy-price') as HTMLInputElement).value);
  const annualMaint = parseInt((document.getElementById('annual-maintenance') as HTMLInputElement).value) || 0;
  const channelBenefit = parseInt((document.querySelector('input[name="rental-channel"]:checked') as HTMLInputElement)?.value ?? '0');
  const ownership = parseInt((document.querySelector('input[name="rental-ownership"]:checked') as HTMLInputElement)?.value ?? '0');
  if (!fee || !buyPrice) { alert('렌탈료와 구매 가격을 입력해주세요.'); return; }
  const ownershipCost = ownership === 2 ? 75000 : 0;
  const totalRental = fee * months - channelBenefit + ownershipCost;
  const totalBuy = buyPrice + (annualMaint * months / 12);
  const fmt = (n: number) => Math.round(Math.abs(n)/10000) + '만원';
  let breakEven = 0;
  for (let m=1; m<=200; m++) {
    const rCost = fee * m - channelBenefit + ownershipCost;
    const bCost = buyPrice + annualMaint * m / 12;
    if (bCost < rCost) { breakEven = m; break; }
  }
  const diff = totalRental - totalBuy;
  const rangeEl = document.getElementById('rental-range') as HTMLElement;
  if (diff > 0) {
    rangeEl.innerHTML = `${months}개월 기준 구매가 <strong>${fmt(diff)}</strong> 저렴`;
  } else if (diff < 0) {
    rangeEl.innerHTML = `${months}개월 기준 렌탈이 <strong>${fmt(diff)}</strong> 저렴`;
  } else {
    rangeEl.innerHTML = `${months}개월 기준 렌탈과 구매 비용이 동일합니다`;
  }
  const detailLines = [
    `렌탈 총비용: ${fmt(totalRental)}원${channelBenefit > 0 ? ` (혜택 ${fmt(channelBenefit)} 차감)` : ''}`,
    `구매 총비용: ${fmt(Math.round(totalBuy))}원 (유지비 포함)`,
    breakEven > 0 ? `구매가 유리해지는 시점: ${breakEven}개월 이후` : `약정 기간 내 구매가 더 유리`
  ];
  (document.getElementById('rental-detail') as HTMLElement).innerHTML = detailLines.join('<br>');
  // CTA 분기
  const ctaWrap = document.getElementById('rental-cta-wrap') as HTMLElement;
  if (diff >= 0 || channelBenefit > 0) {
    ctaWrap.innerHTML = `
      <p class="result-cta-label">${diff >= -300000 ? '렌탈과 구매 비용 차이가 크지 않습니다. 비교채널 경유 가입 시 추가 혜택으로 차이를 더 줄일 수 있습니다.' : '렌탈이 더 유리합니다. 비교채널 경유 가입 시 최대 31만원 혜택까지 확인하세요.'}</p>
      <a href="https://partners.ajl.to/lead/rental?partnerId=UDXBJ0IC" rel="nofollow sponsored noopener" data-partner-cta="true" class="result-cta-btn">
        렌탈 조건 비교하기 →
      </a>
      <p class="result-cta-note">* 제휴 링크 · 이용자 추가 비용 없음 · <a href="/affiliate-disclosure/" style="color:inherit;text-decoration:underline">제휴 고지</a></p>`;
  } else {
    ctaWrap.innerHTML = `
      <p class="result-cta-label">구매가 유리하더라도, 비교채널 경유 렌탈 가입 시 평균 20만원 혜택으로 실질 차이를 줄일 수 있습니다.</p>
      <a href="/rental/" class="result-cta-btn" style="background:var(--primary)">렌탈 조건 상세 확인 →</a>`;
  }
  const res = document.getElementById('rental-result') as HTMLElement;
  res.style.display = 'block';
  res.scrollIntoView({ behavior:'smooth', block:'nearest' });
});

// 렌탈 초기화
document.getElementById('rental-reset-btn')?.addEventListener('click', () => {
  (document.getElementById('rental-fee') as HTMLInputElement).value = '';
  (document.getElementById('rental-months') as HTMLSelectElement).value = '60';
  (document.getElementById('buy-price') as HTMLInputElement).value = '';
  (document.getElementById('annual-maintenance') as HTMLInputElement).value = '0';
  (document.querySelector('input[name="rental-channel"][value="0"]') as HTMLInputElement).checked = true;
  (document.querySelector('input[name="rental-ownership"][value="0"]') as HTMLInputElement).checked = true;
  document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('selected'));
  (document.getElementById('rental-result') as HTMLElement).style.display = 'none';
});

document.getElementById('rental-retry-btn')?.addEventListener('click', () => {
  (document.getElementById('rental-result') as HTMLElement).style.display = 'none';
  document.getElementById('rental-calc-btn')?.scrollIntoView({ behavior:'smooth', block:'center' });
});

// ③ 전기요금 계산기
document.getElementById('jeongi-calc-btn')?.addEventListener('click', () => {
  const watt = parseInt((document.getElementById('ac-watt') as HTMLSelectElement).value);
  const tempFactor = parseFloat((document.getElementById('ac-temp') as HTMLSelectElement).value);
  const hours = parseFloat((document.getElementById('ac-hours') as HTMLInputElement).value);
  const days = parseInt((document.getElementById('ac-days') as HTMLInputElement).value);
  const fanFactor = parseFloat((document.querySelector('input[name="ac-fan"]:checked') as HTMLInputElement)?.value ?? '1');
  const price = parseInt((document.getElementById('kwh-price') as HTMLSelectElement).value);
  const effectiveWatt = watt * tempFactor * fanFactor;
  const kwhPerMonth = effectiveWatt / 1000 * hours * days;
  const cost = Math.round(kwhPerMonth * price);
  (document.getElementById('jeongi-range') as HTMLElement).innerHTML =
    `월 추가 전기요금 약 <strong>${cost.toLocaleString('ko-KR')}원</strong>`;
  const savingBase = watt / 1000 * hours * days * price;
  const saving = Math.round(savingBase - cost);
  (document.getElementById('jeongi-detail') as HTMLElement).innerHTML =
    `소비 전력량 ${kwhPerMonth.toFixed(1)} kWh${saving > 0 ? ` · 26°C 기준 대비 월 ${saving.toLocaleString('ko-KR')}원 절약` : saving < 0 ? ` · 26°C 기준 대비 월 ${Math.abs(saving).toLocaleString('ko-KR')}원 추가` : ''}`;
  const res = document.getElementById('jeongi-result') as HTMLElement;
  res.style.display = 'block';
  res.scrollIntoView({ behavior:'smooth', block:'nearest' });
});

// 전기요금 초기화
document.getElementById('jeongi-reset-btn')?.addEventListener('click', () => {
  (document.getElementById('ac-watt') as HTMLSelectElement).value = '1500';
  (document.getElementById('ac-temp') as HTMLSelectElement).value = '1';
  (document.getElementById('ac-hours') as HTMLInputElement).value = '6';
  (document.getElementById('ac-days') as HTMLInputElement).value = '30';
  (document.querySelector('input[name="ac-fan"][value="1"]') as HTMLInputElement).checked = true;
  (document.getElementById('kwh-price') as HTMLSelectElement).value = '185';
  (document.getElementById('jeongi-result') as HTMLElement).style.display = 'none';
});

document.getElementById('jeongi-retry-btn')?.addEventListener('click', () => {
  (document.getElementById('jeongi-result') as HTMLElement).style.display = 'none';
  document.getElementById('jeongi-calc-btn')?.scrollIntoView({ behavior:'smooth', block:'center' });
});
</script>

</Layout>
