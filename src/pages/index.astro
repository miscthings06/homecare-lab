---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
---
<Layout
  title="홈케어랩│homecare-lab.co.kr"
  description="청소부터 가전렌탈까지, 우리집 생활비 줄이는 홈서비스 가이드. 입주청소·이사청소 비용, 정수기·공기청정기 렌탈 비교, 이사 전후 준비, 전기요금 절약 정보를 확인하세요."
>

<!-- 뉴스 포털 본문 (메인 + 사이드바) -->
<div class="home-news container">
  <div class="home-main">

    <!-- 대표 기사 -->
    <a href="/cheongso/ipju-cheongso-biyong/" class="lead">
      <div class="lead-cover">
        <span class="emo" aria-hidden="true">🏠</span>
        <span class="lead-cover-label">이번 주 가이드</span>
      </div>
      <div class="lead-body">
        <span class="lead-tag">청소비용</span>
        <h2>입주청소 비용, 평수·조건별 기준 총정리</h2>
        <p>30평 기준 평균 28~40만원. 창틀·베란다·에어컨 청소 포함 여부에 따라 실제 청구액이 크게 달라집니다. 견적 전 확인할 기준을 정리했습니다.</p>
        <span class="lead-byline">닥터 홈케어 · 청소비용 가이드</span>
      </div>
    </a>

    <!-- 청소비용 -->
    <section class="home-sec">
      <div class="home-sec-head">
        <h2>청소비용</h2>
        <a href="/cheongso/" class="home-sec-more">+ 더보기</a>
      </div>
      <div class="home-list">
        <a href="/cheongso/isa-cheongso/" class="home-item">
          <span class="home-thumb" style="background:#e1f5ee" aria-hidden="true">📦</span>
          <div><h3>이사청소와 입주청소, 무엇이 다를까</h3><span class="sub">목적·범위·비용 차이 비교</span></div>
        </a>
        <a href="/cheongso/aircon-cheongso/" class="home-item">
          <span class="home-thumb" style="background:#e1f5ee" aria-hidden="true">❄️</span>
          <div><h3>에어컨 청소 셀프 vs 업체 비교</h3><span class="sub">종류별 업체 청소 비용</span></div>
        </a>
        <a href="/cheongso/yoksil-gompalgi/" class="home-item">
          <span class="home-thumb" style="background:#e1f5ee" aria-hidden="true">🧽</span>
          <div><h3>욕실 곰팡이 제거 방법과 재발 방지</h3><span class="sub">부위별 제거 난이도</span></div>
        </a>
        <a href="/cheongso/hood-biyong/" class="home-item">
          <span class="home-thumb" style="background:#e1f5ee" aria-hidden="true">🍳</span>
          <div><h3>주방 후드 청소 비용과 주기</h3><span class="sub">종류별 전문 청소 비용</span></div>
        </a>
      </div>
    </section>

    <!-- 가전렌탈 -->
    <section class="home-sec">
      <div class="home-sec-head">
        <h2>가전렌탈</h2>
        <a href="/rental/" class="home-sec-more">+ 더보기</a>
      </div>
      <div class="home-list">
        <a href="/rental/jeongsugi-rental/" class="home-item">
          <span class="home-thumb" style="background:#e6f1fb" aria-hidden="true">💧</span>
          <div><h3>정수기 렌탈 vs 구매 5년 총비용</h3><span class="sub">필터·관리비 포함 비교</span></div>
        </a>
        <a href="/rental/rental-vs-purchase/" class="home-item">
          <span class="home-thumb" style="background:#e6f1fb" aria-hidden="true">🔄</span>
          <div><h3>가전 렌탈 vs 구매, 어느 쪽이 유리?</h3><span class="sub">제품별 5년 총비용</span></div>
        </a>
        <a href="/rental/gonggi-rental/" class="home-item">
          <span class="home-thumb" style="background:#e6f1fb" aria-hidden="true">🌬️</span>
          <div><h3>공기청정기 렌탈 비용과 구매 비교</h3><span class="sub">공간별 월 요금</span></div>
        </a>
        <a href="/rental/geondogi-rental/" class="home-item">
          <span class="home-thumb" style="background:#e6f1fb" aria-hidden="true">👕</span>
          <div><h3>건조기 렌탈 비용과 구매 비교</h3><span class="sub">히트펌프·드럼 기준</span></div>
        </a>
      </div>
    </section>

    <!-- 이사준비 -->
    <section class="home-sec">
      <div class="home-sec-head">
        <h2>이사준비</h2>
        <a href="/isa-junbi/" class="home-sec-more">+ 더보기</a>
      </div>
      <div class="home-list">
        <a href="/isa-junbi/homeservice-dday/" class="home-item">
          <span class="home-thumb" style="background:#faeeda" aria-hidden="true">📅</span>
          <div><h3>이사 홈서비스 D-30 준비 타임라인</h3><span class="sub">신청 순서 한눈에</span></div>
        </a>
        <a href="/isa-junbi/internet-sinyu-vs-isa/" class="home-item">
          <span class="home-thumb" style="background:#faeeda" aria-hidden="true">📶</span>
          <div><h3>인터넷 이전 vs 신규 가입 비교</h3><span class="sub">위약금·혜택·개통 기간</span></div>
        </a>
        <a href="/isa-junbi/dosigas/" class="home-item">
          <span class="home-thumb" style="background:#faeeda" aria-hidden="true">🔥</span>
          <div><h3>도시가스 이전·명의변경 방법</h3><span class="sub">나가는 집·새 집 처리</span></div>
        </a>
        <a href="/isa-junbi/pojang-isa/" class="home-item">
          <span class="home-thumb" style="background:#faeeda" aria-hidden="true">🚚</span>
          <div><h3>포장이사 vs 일반이사 비용 차이</h3><span class="sub">평수별 비용 비교</span></div>
        </a>
      </div>
    </section>

    <!-- 생활비절감 -->
    <section class="home-sec">
      <div class="home-sec-head">
        <h2>생활비절감</h2>
        <a href="/jeolryak/" class="home-sec-more">+ 더보기</a>
      </div>
      <div class="home-list">
        <a href="/jeolryak/aircon-jeongi/" class="home-item">
          <span class="home-thumb" style="background:#eaf3de" aria-hidden="true">⚡</span>
          <div><h3>에어컨 전기요금 계산법</h3><span class="sub">사용 시간별 요금 기준</span></div>
        </a>
        <a href="/jeolryak/nanbangbi-jeollyak/" class="home-item">
          <span class="home-thumb" style="background:#eaf3de" aria-hidden="true">🌡️</span>
          <div><h3>겨울 난방비 줄이는 보일러 설정</h3><span class="sub">온도 1도=약 7% 절감</span></div>
        </a>
        <a href="/jeolryak/jeongi-nujin/" class="home-item">
          <span class="home-thumb" style="background:#eaf3de" aria-hidden="true">📊</span>
          <div><h3>전기요금 누진제 구간 기준</h3><span class="sub">구간별 단가 정리</span></div>
        </a>
        <a href="/jeolryak/energy-voucher/" class="home-item">
          <span class="home-thumb" style="background:#eaf3de" aria-hidden="true">🎫</span>
          <div><h3>에너지바우처 신청 방법</h3><span class="sub">대상·금액·사용처</span></div>
        </a>
      </div>
    </section>

  </div>

  <div class="home-side">
    <Sidebar />
  </div>
</div>

<!-- 비용 계산기 (다크) -->
<section class="calc-cta-section">
  <div class="container">
    <h2 class="section-title">내 상황에 맞는 비용, 직접 계산해보세요</h2>
    <p class="section-sub">청소 견적 기준, 렌탈과 구매 손익분기, 가전 전기요금까지 — 조건을 입력하면 예상 비용을 바로 확인할 수 있습니다.</p>
    <div class="card-grid" style="max-width:900px;margin:0 auto">
      <a href="/calculator/#ipju" class="card card-calc" style="text-decoration:none">
        <div class="card-icon">🏠</div>
        <h3>입주청소 예상비용 계산기</h3>
        <p>평수·주거형태·오염도 등 9가지 조건으로 예상 비용 범위를 계산합니다.</p>
        <span class="card-link">계산하기 →</span>
      </a>
      <a href="/calculator/#rental" class="card card-calc" style="text-decoration:none">
        <div class="card-icon">🔄</div>
        <h3>렌탈 vs 구매 손익분기 계산기</h3>
        <p>관리비 포함 렌탈 총비용과 구매 총비용을 비교해 유리한 쪽을 확인합니다.</p>
        <span class="card-link">계산하기 →</span>
      </a>
      <a href="/calculator/#jeongi" class="card card-calc" style="text-decoration:none">
        <div class="card-icon">⚡</div>
        <h3>가전 전기요금 계산기</h3>
        <p>에어컨·건조기·냉장고 등 9종 가전의 월 전기요금을 추정합니다.</p>
        <span class="card-link">계산하기 →</span>
      </a>
    </div>
  </div>
</section>

<!-- 운영 기준 (Editorial) -->
<div class="editorial-section">
  <div class="editorial-inner">
    <div class="editorial-copy">
      <span class="editorial-eyebrow">운영 기준</span>
      <h2 class="section-title">광고보다 먼저, 판단 기준을 제공합니다</h2>
      <p style="color:var(--text-muted);font-size:0.95rem;line-height:1.7;margin:0">
        청소·렌탈 정보는 비용만 보면 실제 손익을 놓치기 쉽습니다. 홈케어랩은 사은품 문구를 반복하기보다
        집 상태와 사용 조건에 따라 달라지는 판단 기준을 구조화하는 것을 우선합니다.
      </p>
    </div>
    <ul class="editorial-list">
      <li>
        <h3>비용은 총액으로 봅니다</h3>
        <p>월 렌탈료만 보지 않고 약정 기간, 위약금, 관리비, 필터 교체 비용을 전체 기간 기준으로 함께 계산합니다.</p>
      </li>
      <li>
        <h3>정보 출처와 시점을 남깁니다</h3>
        <p>비용 기준과 서비스 조건은 변동 가능성이 있다는 점과 함께, 정보의 근거와 기준 시점을 함께 표시합니다.</p>
      </li>
      <li>
        <h3>제휴 관계를 숨기지 않습니다</h3>
        <p>파트너 링크를 통해 신청이 발생하면 운영자에게 수수료가 지급될 수 있습니다. 이 사실은 <a href="/affiliate-disclosure/">제휴 고지 페이지</a>에 명시합니다.</p>
      </li>
    </ul>
  </div>
</div>

<!-- 자주 묻는 질문 -->
<div class="home-faq">
  <div class="home-faq-inner">
    <h2 class="section-title">자주 묻는 질문</h2>
    <p class="section-sub">청소·렌탈·이사 서비스 이용 전 가장 많이 묻는 질문들. 자세한 답변은 각 가이드 글에서 확인하세요.</p>
    <dl class="faq-dl">
      <details name="hfaq" class="faq-details" open>
        <summary><span class="faq-q-mark">Q.</span> 홈케어랩에서 직접 청소 예약이 가능한가요?</summary>
        <dd>홈케어랩은 청소·렌탈 서비스 직접 제공자가 아닙니다. 자체 예약·상담 폼을 운영하지 않습니다. 본문 내 파트너 링크를 통해 아정당(ajd.co.kr)으로 이동하면 전문 상담과 견적 비교를 받을 수 있습니다.</dd>
      </details>
      <details name="hfaq" class="faq-details">
        <summary><span class="faq-q-mark">Q.</span> 아정당은 무엇이고, 이 사이트와 어떤 관계인가요?</summary>
        <dd>아정당(ajd.co.kr)은 청소·홈케어 서비스 업체를 연결해주는 국내 비교·상담 플랫폼입니다. 홈케어랩은 아정당 공식 운영사가 아닌 별도의 정보 제공 사이트입니다. 본문의 파트너 링크를 통해 신청이 발생할 경우 사이트 운영자에게 일정 수수료가 지급됩니다(아정당 파트너스).</dd>
      </details>
      <details name="hfaq" class="faq-details">
        <summary><span class="faq-q-mark">Q.</span> 이 사이트 링크로 신청하면 추가 비용이 발생하나요?</summary>
        <dd>없습니다. 제휴 링크를 통해 신청해도 이용자가 직접 신청하는 것과 동일한 비용이 적용됩니다. 제휴 수수료는 서비스 제공자 측에서 사이트 운영자에게 별도 지급되는 구조로, 이용자 비용에는 영향이 없습니다.</dd>
      </details>
      <details name="hfaq" class="faq-details">
        <summary><span class="faq-q-mark">Q.</span> 렌탈과 구매 중 어느 쪽이 더 유리한가요?</summary>
        <dd>"어느 쪽이 더 유리하다"보다 "내 사용 기간과 관리 편의성에서 어느 쪽이 맞는가"가 정답에 가깝습니다. 5년 이상 장기 사용을 계획한다면 총비용 면에서 구매가 유리한 경우가 많고, 이사가 잦거나 초기 비용 부담이 크다면 렌탈이 적합할 수 있습니다.</dd>
      </details>
      <details name="hfaq" class="faq-details">
        <summary><span class="faq-q-mark">Q.</span> 입주청소 비용은 평수만으로 정해지나요?</summary>
        <dd>아닙니다. 평수는 기준이 되지만, 실제 비용은 오염도·창틀·베란다·주방 후드 포함 여부·에어컨 청소 추가 여부에 따라 달라집니다. 견적 시 기본 범위와 추가 항목 조건을 함께 확인하는 것이 중요합니다.</dd>
      </details>
    </dl>
  </div>
</div>

<!-- 최종 CTA -->
<section class="cta-section">
  <div class="container" style="text-align:center;max-width:700px">
    <h2>비교 기준을 확인했다면 실제 견적을 받아보세요</h2>
    <p>청소 범위, 렌탈 약정, 이사 일정을 정리한 뒤 상담받으면 불필요한 추가 비용이나 불리한 약정을 피하기 쉽습니다.</p>
    <div class="cta-block" data-variant="final" style="background:rgba(255,255,255,0.1);border-color:rgba(255,255,255,0.2);margin-top:1.5rem">
      <p class="cta-intro" style="color:rgba(255,255,255,0.75)">견적이 필요하다면</p>
      <ul class="cta-chips" aria-label="파트너 서비스 혜택">
        <li class="cta-chip cta-chip-cash">무료 견적 비교</li>
        <li class="cta-chip cta-chip-gift">전국 서비스 가능</li>
        <li class="cta-chip cta-chip-shield">후기 기반 업체 매칭</li>
      </ul>
      <a class="cta-btn-pill" href="https://ajd.co.kr" rel="nofollow sponsored noopener" data-partner-cta="true">
        업체별 견적받기 →
      </a>
      <p class="cta-subcopy" style="color:rgba(255,255,255,0.5)">상담·계약·개통은 아정당 및 각 업체를 통해 진행됩니다</p>
    </div>
  </div>
</section>

</Layout>

<style>
/* 뉴스 포털 홈 */
.home-news {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 290px;
  gap: 32px;
  padding: 28px 20px 16px;
  align-items: start;
}
.home-main { display: flex; flex-direction: column; gap: 28px; }
.home-side { position: sticky; top: 60px; }

/* 대표 기사 */
.lead {
  display: flex; gap: 20px;
  background: #fff; border: 1px solid var(--border); border-radius: 14px;
  overflow: hidden; text-decoration: none; color: inherit;
  transition: box-shadow .2s, transform .2s;
}
.lead:hover { box-shadow: 0 6px 22px rgba(47,191,155,.14); transform: translateY(-2px); text-decoration: none; }
.lead-cover {
  flex: 0 0 220px; background: #e1f5ee;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px;
  min-height: 200px;
}
.lead-cover .emo { font-size: 3rem; }
.lead-cover-label { font-size: .72rem; font-weight: 700; letter-spacing: 1px; color: var(--accent-dark); }
.lead-body { flex: 1; padding: 22px 24px 22px 4px; display: flex; flex-direction: column; justify-content: center; }
.lead-tag { font-size: .72rem; font-weight: 700; color: var(--accent-dark); background: var(--primary-light); border-radius: 999px; padding: 3px 11px; width: fit-content; }
.lead-body h2 { font-size: 1.5rem; font-weight: 800; line-height: 1.35; margin: 12px 0 10px; color: var(--primary); }
.lead-body p { font-size: .95rem; color: var(--text-muted); line-height: 1.65; margin: 0 0 12px; }
.lead-byline { font-size: .8rem; color: #9a9488; }

/* 카테고리 섹션 블록 */
.home-sec-head {
  display: flex; align-items: center; justify-content: space-between;
  border-bottom: 2px solid var(--primary); padding-bottom: 7px; margin-bottom: 14px;
}
.home-sec-head h2 { font-size: 1.15rem; font-weight: 800; color: var(--primary); margin: 0; }
.home-sec-more { font-size: .8rem; color: var(--text-muted); }
.home-sec-more:hover { color: var(--accent-dark); text-decoration: none; }
.home-list { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.home-item { display: flex; gap: 12px; align-items: center; text-decoration: none; color: inherit; }
.home-thumb {
  flex: 0 0 54px; height: 54px; border-radius: 8px;
  display: flex; align-items: center; justify-content: center; font-size: 1.5rem;
}
